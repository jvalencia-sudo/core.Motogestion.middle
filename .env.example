# ──────────────────────────────────────────────────────────────
# Variables del FRONT (Next.js). En local van en .env (gitignored).
# En PRODUCCIÓN se configuran en Vercel → Project Settings → Environment Variables.
# Los valores de secretos cópialos de tu .env local.
# ──────────────────────────────────────────────────────────────

# URL pública del front. EN PRODUCCIÓN DEBE SER https (Auth0 lo exige).
# = la URL que te da Vercel (https://<tu-proyecto>.vercel.app) o tu dominio.
APP_BASE_URL=http://localhost:3000
AUTH0_BASE_URL=http://localhost:3000   # mismo valor que APP_BASE_URL (resto v3)

# Auth0 (mismos valores del tenant que uses; por ahora el de dev)
AUTH0_DOMAIN=dev-q4srpexn6ajjjfqs.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://dev-q4srpexn6ajjjfqs.us.auth0.com
AUTH0_CLIENT_ID=__copiar_de_tu_.env__
AUTH0_CLIENT_SECRET=__copiar_de_tu_.env__
AUTH0_SECRET=__copiar_de_tu_.env__       # clave de cifrado de cookies
AUTH0_AUDIENCE=https://moto.com/api
# El backend nunca valida scopes de Auth0 (autoriza con su propia tabla de
# permisos, ver README del backend) -- estos son solo los estándar de OIDC
# para identificar al usuario (nombre/correo).
AUTH0_SCOPE=openid profile email

# Backend (API en producción, VM propia en Oracle Cloud). Server-side only:
# el front nunca le pega directo al backend desde el navegador, todo pasa
# por /api/* (middleware.ts lo reescribe con el token de sesión puesto).
BASE_API_URL=https://api.motogestion.app/api

# Link completo de WhatsApp (wa.me/...) para el contacto de "varias sedes o
# necesidades especiales" en la landing. NEXT_PUBLIC_ porque se usa en el
# cliente/HTML directamente, no es secreto.
NEXT_PUBLIC_WHATSAPP_CONTACTO=https://wa.me/573000000000

# --- Sentry (monitoreo de errores; opcional, vacío = deshabilitado) ---
# DSN del proyecto de Sentry (sentry.io → proyecto → Settings → Client Keys (DSN)).
# NEXT_PUBLIC_ porque el DSN no es secreto (se manda igual en cada evento).
NEXT_PUBLIC_SENTRY_DSN=
# Solo hacen falta en el build de Vercel, para subir source maps. Vacíos, el
# plugin se salta la subida con un warning, no rompe el build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
